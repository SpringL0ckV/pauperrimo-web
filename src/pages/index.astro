---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const ensayos = (await getCollection('ensayos')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const destacado = ensayos[0];
const archivo = ensayos.slice(1);
const tags = [...new Set(ensayos.flatMap((ensayo) => ensayo.data.tags))].sort();
const manifiesto = ensayos.find((ensayo) => ensayo.data.tags.includes('Manifiesto'));
---

<BaseLayout title="Paupérrimo — Ideas de bajo presupuesto" description="Ensayos sobre videojuegos, cultura pop y filosofía.">
  <div class="site-shell">
    <nav class="site-nav" aria-label="Navegación principal">
      <a class="wordmark" href="/">Paupérrimo<span>.</span></a>
      <div class="nav-links">
        <a href="#ensayos">Ensayos</a>
        {manifiesto && <a href={`/ensayos/${manifiesto.id}`}>Manifiesto</a>}
        <a href="/sobre">Sobre el proyecto</a>
      </div>
      <span class="issue-label">Vol. 01 / 2026</span>
    </nav>

    <main id="contenido">
      <header class="hero" id="inicio">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> Un medio sobre jugar y pensar</p>
          <h1>Ideas de bajo presupuesto<span class="accent-dot">.</span></h1>
          <p class="hero-intro">
            Videojuegos, cultura pop y filosofía sin la obligación de tener respuestas rápidas.
            Pensar despacio también es una forma de resistencia.
          </p>
          <a class="text-link" href="#ensayos">Explorar los ensayos <span aria-hidden="true">↘</span></a>
        </div>
        <div class="hero-mark" aria-hidden="true">
          <span>PP</span>
          <small>pauperrimo<br />est. 2026</small>
        </div>
      </header>

      {destacado && (
        <section class="featured-section" id="destacado" aria-labelledby="featured-heading">
          <div class="section-kicker"><span>01</span><span>Lectura destacada</span></div>
          <article class="featured-piece">
            <div class="featured-index" aria-hidden="true">A</div>
            <div class="featured-content">
              <div class="tag-row">
                {destacado.data.tags.map((tag) => <span>{tag}</span>)}
              </div>
              <h2 id="featured-heading"><a href={`/ensayos/${destacado.id}`}>{destacado.data.title}</a></h2>
              <p>{destacado.data.description}</p>
              <div class="piece-meta">
                <span>{destacado.data.author}</span>
                <span>{destacado.data.pubDate.toLocaleDateString('es-ES')}</span>
                <a href={`/ensayos/${destacado.id}`}>Leer completo <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </article>
        </section>
      )}

      <section class="archive-section" id="ensayos" aria-labelledby="archive-heading">
        <div class="section-heading">
          <div class="section-kicker"><span>02</span><span>El archivo</span></div>
          <h2 id="archive-heading">Todo lo que<br /><em>queda por pensar.</em></h2>
        </div>
        {archivo.length > 0 ? (
          <div class="archive-column">
            <div class="archive-tools">
              <label class="search-box">
                <span aria-hidden="true">⌕</span>
                <input id="essay-search" type="search" placeholder="Buscar en el archivo" aria-label="Buscar en el archivo" />
              </label>
              <div class="filter-row" aria-label="Filtrar por categoría">
                <button class="filter-button is-active" type="button" data-filter="all" aria-pressed="true">Todo</button>
                {tags.map((tag) => <button class="filter-button" type="button" data-filter={tag} aria-pressed="false">{tag}</button>)}
              </div>
            </div>
            <div class="archive-list">
            {archivo.map((ensayo, index) => (
              <article class="archive-item" data-title={`${ensayo.data.title} ${ensayo.data.description}`.toLowerCase()} data-tags={ensayo.data.tags.join('|')}>
                <span class="archive-number" aria-hidden="true">{String(index + 2).padStart(2, '0')}</span>
                <div>
                  <div class="tag-row">{ensayo.data.tags.map((tag) => <span>{tag}</span>)}</div>
                  <h3><a href={`/ensayos/${ensayo.id}`}>{ensayo.data.title}</a></h3>
                  <p>{ensayo.data.description}</p>
                </div>
                <span class="archive-arrow" aria-hidden="true">↗</span>
              </article>
            ))}
            </div>
            <p class="empty-archive is-hidden" id="no-results" role="status">No hay textos que coincidan con esa búsqueda.</p>
          </div>
        ) : (
          <p class="empty-archive">El archivo acaba de abrir. Pronto habrá más cosas que leer.</p>
        )}
      </section>
    </main>

    <footer class="site-footer">
      <span>Paupérrimo © 2026</span>
      <span>Hecho con curiosidad y poco presupuesto.</span>
      <a href="#inicio">Volver arriba ↑</a>
    </footer>
  </div>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('#essay-search');
  const items = [...document.querySelectorAll<HTMLElement>('.archive-item')];
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.filter-button')];
  let activeFilter = 'all';

  const updateArchive = () => {
    const query = search?.value.trim().toLowerCase() ?? '';
    let visible = 0;
    items.forEach((item) => {
      const matchesFilter = activeFilter === 'all' || item.dataset.tags?.split('|').includes(activeFilter);
      const matchesSearch = !query || item.dataset.title?.includes(query);
      const shouldShow = Boolean(matchesFilter && matchesSearch);
      item.hidden = !shouldShow;
      if (shouldShow) visible += 1;
    });
    document.querySelector<HTMLElement>('#no-results')?.classList.toggle('is-hidden', visible > 0);
  };

  search?.addEventListener('input', updateArchive);
  buttons.forEach((button) => button.addEventListener('click', () => {
    activeFilter = button.dataset.filter ?? 'all';
    buttons.forEach((current) => {
      const isActive = current === button;
      current.classList.toggle('is-active', isActive);
      current.setAttribute('aria-pressed', String(isActive));
    });
    updateArchive();
  }));
</script>
